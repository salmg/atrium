# ATRIUM configuration — copy to .env and edit, or export these in your shell.
# Every value here is optional; ATRIUM runs with none of them set.
# .env is gitignored. Never commit real keys or tokens.

# ── AI agent back end (optional) ─────────────────────────────────────────────
# The agent is the only part that needs a model. Relay, fingerprinting,
# mutations, logs and card intel all work without one.
#
# Auto-detection order: ATRIUM_LLM_PROVIDER, then ANTHROPIC_API_KEY,
# then OPENAI_API_KEY, then ATRIUM_LLM_BASE_URL.

# Force a back end instead of auto-detecting: anthropic | openai | local | none
#ATRIUM_LLM_PROVIDER=

# Anthropic — also needs: pip install anthropic
#ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI — no extra install
#OPENAI_API_KEY=sk-...

# Local / OpenAI-compatible server — no extra install.
# Ollama http://localhost:11434/v1 · LM Studio http://localhost:1234/v1
# vLLM   http://localhost:8000/v1
# The model must support tool calling (llama3.1, qwen2.5, mistral-nemo do).
#ATRIUM_LLM_BASE_URL=http://localhost:11434/v1
#ATRIUM_LLM_MODEL=qwen2.5:14b
#ATRIUM_LLM_API_KEY=local

# ── Serving beyond loopback (optional) ───────────────────────────────────────
# ATRIUM binds 127.0.0.1 by default and refuses a wider bind without a token,
# because the API has no login. Prefer an SSH tunnel over exposing the port:
#     ssh -L 8000:127.0.0.1:8000 user@research-host
#
# Generate with: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
#ATRIUM_API_TOKEN=

# Extra Host header values to accept. Loopback is always allowed; anything else
# is rejected with 421 to defeat DNS rebinding.
#ATRIUM_ALLOWED_HOSTS=atrium.lab.internal

# ── Cross-network card link (optional) ───────────────────────────────────────
# Where the link identity (certificate, key, token) is stored.
#ATRIUM_HOME=~/.atrium

# ── Host layer: acquirer / gateway / issuer testing (optional) ───────────────
# See host/README.md. Nothing here is needed for the card-present side.
#
# Issuer master key, for cryptogram verification and re-signing. An IMK derives
# every card key in its range, so prefer this variable or --imk-file over
# passing it on a command line, where any other process can read it from ps.
#HOST_IMK=
#
# Or point at a file holding it, which keeps the key out of the environment of
# every child process ATRIUM starts.
#HOST_IMK_FILE=/etc/atrium/imk.key
